#!/usr/bin/env bash
set -euo pipefail

VERSION="0.1.1"
RELEASE_TAG="v${VERSION}"
RAW_BASE="${GITKEEPR_RAW_BASE:-https://raw.githubusercontent.com/MatousekJakub/gitkeepr/${RELEASE_TAG}}"
WORKFLOW_PATH=".github/workflows/gitkeepr.yml"
SERVER_CONFIG="/etc/gitkeepr/config"
CACHE_DIR="/var/cache/gitkeepr"
RUNNER_USER="github-runner"

say() { printf '%s\n' "$*"; }
die() { printf 'ERROR: %s\n' "$*" >&2; exit 1; }
require_cmd() { command -v "$1" >/dev/null 2>&1 || die "$1 is required. Install it, then run GitKeepr again."; }

usage() {
  cat <<'USAGE'
GitKeepr

Usage:
  gitkeepr init
  gitkeepr doctor
  gitkeepr server init
  gitkeepr server doctor
  gitkeepr runner add OWNER/REPO
  gitkeepr runner remove OWNER/REPO
  gitkeepr version
USAGE
}

repo_name() {
  gh repo view --json nameWithOwner -q .nameWithOwner 2>/dev/null || return 1
}

repo_visibility() {
  gh repo view --json visibility -q .visibility 2>/dev/null || return 1
}

current_var() {
  local repo="$1" name="$2"
  gh variable get "$name" -R "$repo" --json value -q .value 2>/dev/null || true
}

prompt_value() {
  local prompt="$1" default="$2" value
  read -r -p "$prompt [$default]: " value
  printf '%s' "${value:-$default}"
}

require_admin() {
  if [[ "$(id -u)" -eq 0 ]]; then
    return 0
  fi
  require_cmd sudo
  if sudo -n true 2>/dev/null; then
    return 0
  fi
  sudo -v
}

as_root() {
  if [[ "$(id -u)" -eq 0 ]]; then
    "$@"
  else
    sudo "$@"
  fi
}

runner_home() {
  getent passwd "$RUNNER_USER" | cut -d: -f6
}

as_runner() {
  local home
  home="$(runner_home)"
  [[ -n "$home" ]] || die "Could not resolve home directory for $RUNNER_USER."
  if [[ "$(id -u)" -eq 0 ]]; then
    runuser -u "$RUNNER_USER" -- env HOME="$home" PATH="/usr/local/bin:/usr/bin:/bin:$home/.local/bin" "$@"
  else
    sudo -H -u "$RUNNER_USER" env HOME="$home" PATH="/usr/local/bin:/usr/bin:/bin:$home/.local/bin" "$@"
  fi
}

read_protected_file() {
  local path="$1"
  if [[ "$(id -u)" -eq 0 ]]; then
    cat "$path"
  else
    sudo cat "$path"
  fi
}

runner_arch() {
  case "$(uname -m)" in
    x86_64|amd64) printf '%s' "x64" ;;
    aarch64|arm64) printf '%s' "arm64" ;;
    *) die "Unsupported architecture: $(uname -m). GitKeepr V1 supports amd64/x64 and arm64." ;;
  esac
}

runner_cache_path() {
  printf '%s/actions-runner-linux-%s.tar.gz' "$CACHE_DIR" "$(runner_arch)"
}

runner_opencode_path() {
  local home path
  home="$(runner_home)"
  [[ -n "$home" ]] || return 1
  if [[ -x "$home/.opencode/bin/opencode" ]]; then
    printf '%s' "$home/.opencode/bin/opencode"
    return 0
  fi
  path="$(as_runner bash -lc 'command -v opencode' 2>/dev/null || true)"
  [[ -n "$path" ]] || return 1
  printf '%s' "$path"
}

load_server_config() {
  local contents="" key="" value=""
  APP_CLIENT_ID=""
  APP_KEY_PATH=""

  as_root test -e "$SERVER_CONFIG" || die "$SERVER_CONFIG is missing. Run 'gitkeepr server init' first."
  contents="$(read_protected_file "$SERVER_CONFIG" 2>/dev/null || true)"
  [[ -n "$contents" ]] || die "$SERVER_CONFIG is unreadable or empty."

  while IFS='=' read -r key value; do
    case "$key" in
      GITKEEPR_APP_CLIENT_ID) APP_CLIENT_ID="$value" ;;
      GITKEEPR_APP_PRIVATE_KEY_PATH) APP_KEY_PATH="$value" ;;
      GITKEEPR_RUNNER_USER)
        [[ -z "$value" || "$value" == "$RUNNER_USER" ]] || die "Unsupported runner user in $SERVER_CONFIG: $value"
        ;;
    esac
  done <<< "$contents"

  [[ -n "$APP_CLIENT_ID" ]] || die "GITKEEPR_APP_CLIENT_ID is missing in $SERVER_CONFIG."
  [[ -n "$APP_KEY_PATH" ]] || die "GITKEEPR_APP_PRIVATE_KEY_PATH is missing in $SERVER_CONFIG."
  as_root test -r "$APP_KEY_PATH" || die "GitHub App private key is not readable: $APP_KEY_PATH"
}

base64url() {
  openssl base64 -A | tr '+/' '-_' | tr -d '='
}

github_app_jwt() {
  local now iat exp header payload unsigned signature
  now="$(date +%s)"
  iat=$((now - 60))
  exp=$((now + 540))
  header='{"alg":"RS256","typ":"JWT"}'
  payload="$(printf '{"iat":%s,"exp":%s,"iss":"%s"}' "$iat" "$exp" "$APP_CLIENT_ID")"
  unsigned="$(printf '%s' "$header" | base64url).$(printf '%s' "$payload" | base64url)"
  signature="$(printf '%s' "$unsigned" | as_root openssl dgst -sha256 -sign "$APP_KEY_PATH" | base64url)"
  printf '%s.%s' "$unsigned" "$signature"
}

verify_app_access() {
  local repo="$1" jwt installation permissions
  jwt="$(github_app_jwt)"
  if ! installation="$(curl -fsS     -H "Accept: application/vnd.github+json"     -H "Authorization: Bearer $jwt"     "https://api.github.com/repos/$repo/installation")"; then
    die "GitKeepr GitHub App is not installed for $repo or the configured App credentials are invalid."
  fi

  permissions="$(printf '%s' "$installation" | jq -r '.permissions | [.contents, .issues, .pull_requests, .workflows] | @tsv')"
  [[ "$permissions" == $'write\twrite\twrite\twrite' ]] || die "GitKeepr App installation for $repo does not expose the required write permissions (Contents, Issues, Pull requests, Workflows)."
  say "OK    GitKeepr App access verified for $repo"
}

verify_project_vars() {
  local repo="$1" name value missing=0
  for name in GITKEEPR_BUILD_MODEL GITKEEPR_BUILD_VARIANT GITKEEPR_REVIEW_MODEL GITKEEPR_REVIEW_VARIANT GITKEEPR_MAX_CYCLES; do
    value="$(current_var "$repo" "$name")"
    if [[ -n "$value" ]]; then
      say "OK    Repository variable $name is configured"
    else
      say "FAIL  Repository variable $name is missing or empty"
      missing=1
    fi
  done
  [[ "$missing" -eq 0 ]] || die "Repository variables are incomplete. Run 'gitkeepr init' in the project checkout first."
}

sync_app_credentials() {
  local repo="$1"
  gh variable set GITKEEPR_APP_CLIENT_ID -R "$repo" --body "$APP_CLIENT_ID"
  read_protected_file "$APP_KEY_PATH" | gh secret set GITKEEPR_APP_PRIVATE_KEY -R "$repo"
  say "OK    Synchronized GitKeepr App variable and secret"
}

upstream_repo_from_raw_base() {
  local rest
  rest="${RAW_BASE#https://raw.githubusercontent.com/}"
  if [[ "$rest" == "$RAW_BASE" ]]; then
    return 1
  fi
  printf '%s/%s' "${rest%%/*}" "$(printf '%s' "${rest#*/}" | cut -d/ -f1)"
}

is_public_self_repo() {
  local repo="$1" visibility upstream=""
  visibility="$(gh repo view "$repo" --json visibility -q .visibility 2>/dev/null || true)"
  [[ "${visibility,,}" == "public" ]] || return 1
  upstream="$(upstream_repo_from_raw_base || true)"
  [[ -n "$upstream" && "$repo" == "$upstream" ]] || return 1
  gh api "repos/$repo/contents/.github/workflows/self-gate.yml" >/dev/null 2>&1 || return 1
  gh api "repos/$repo/contents/.github/workflows/pr-loop.yml" >/dev/null 2>&1 || return 1
}

validate_target_repo() {
  local repo="$1" visibility
  [[ "$repo" =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]] || die "Repository must be in OWNER/REPO form."
  gh repo view "$repo" >/dev/null 2>&1 || die "Repository $repo is not accessible with the admin gh login."

  visibility="$(gh repo view "$repo" --json visibility -q .visibility)"
  if [[ "${visibility,,}" == "public" ]]; then
    is_public_self_repo "$repo" ||
      die "Standard GitKeepr V1 runner setup does not support public target repositories."
    say "OK    Public upstream repository accepted through the GitKeepr self-development gate"
  else
    say "OK    Private target repository"
  fi
}

runner_dir_for() {
  local repo="$1"
  printf '%s/runners/%s' "$(runner_home)" "${repo//\//-}"
}

runner_name_for() {
  local repo="$1" host repo_part
  host="$(printf '%s' "$(hostname -s)" | tr -c 'A-Za-z0-9._-' '-')"
  repo_part="${repo#*/}"
  repo_part="$(printf '%s' "$repo_part" | tr -c 'A-Za-z0-9._-' '-')"
  printf '%s-%s' "$host" "$repo_part"
}

runner_record() {
  local repo="$1" name="$2"
  gh api "repos/$repo/actions/runners?per_page=100"     --jq ".runners[] | select(.name == \"$name\") | [.id, .status, (.busy|tostring)] | @tsv" |
    head -n1
}

runner_service_healthy() {
  local dir="$1"
  [[ -x "$dir/svc.sh" ]] || return 1
  as_root bash -c 'cd "$1" && ./svc.sh status >/dev/null 2>&1' _ "$dir"
}

warn_if_caller_missing() {
  local repo="$1"
  if is_public_self_repo "$repo"; then
    say "OK    Public self-development workflows are visible on the default branch"
    return 0
  fi

  if gh api "repos/$repo/contents/.github/workflows/gitkeepr.yml" >/dev/null 2>&1; then
    say "OK    .github/workflows/gitkeepr.yml is visible on the default branch"
  else
    say "WARN  .github/workflows/gitkeepr.yml is not visible on the default branch yet; commit/push it from the project checkout when ready"
  fi
}

remove_runner_installation() {
  local repo="$1" dir="$2" runner_id="$3" token=""

  if [[ -x "$dir/svc.sh" ]]; then
    as_root bash -c 'cd "$1" && ./svc.sh stop >/dev/null 2>&1 || true' _ "$dir"
    as_root bash -c 'cd "$1" && ./svc.sh uninstall >/dev/null 2>&1 || true' _ "$dir"
  fi

  if [[ -x "$dir/config.sh" && -f "$dir/.runner" ]]; then
    token="$(gh api -X POST "repos/$repo/actions/runners/remove-token" --jq .token)"
    as_runner bash -c 'cd "$1" && ./config.sh remove --token "$2"' _ "$dir" "$token" || true
  fi

  if [[ -n "$runner_id" ]]; then
    gh api -X DELETE "repos/$repo/actions/runners/$runner_id" >/dev/null 2>&1 || true
  fi

  if [[ -d "$dir" ]]; then
    as_root rm -rf "$dir"
  fi
}

project_init() {
  require_cmd git
  require_cmd gh
  require_cmd curl
  git rev-parse --show-toplevel >/dev/null 2>&1 || die "Run 'gitkeepr init' inside a Git repository."
  gh auth status >/dev/null 2>&1 || die "GitHub CLI is not authenticated. Run 'gh auth login', then try again."

  local repo visibility self_repo=0
  repo="$(repo_name)" || die "Could not resolve the GitHub repository. Ensure the checkout has a GitHub remote usable by 'gh repo view'."
  visibility="$(repo_visibility)" || die "Could not determine repository visibility for $repo."
  if [[ "${visibility,,}" == "public" ]]; then
    if is_public_self_repo "$repo"; then
      self_repo=1
    else
      die "Standard GitKeepr V1 setup does not support public target repositories with persistent self-hosted runners."
    fi
  fi

  say "Repository: $repo"
  if [[ "$self_repo" -eq 1 ]]; then
    say "Mode: public GitKeepr self-development through the GitHub-hosted self-gate"
  fi
  say ""
  say "Before continuing, add this repository to the GitKeepr GitHub App under 'Selected repositories'."
  local app_ok
  read -r -p "Is the GitKeepr App installed for this repository? [y/N]: " app_ok
  [[ "$app_ok" =~ ^[Yy]$ ]] || die "Add $repo to the GitKeepr GitHub App installation, then run 'gitkeepr init' again."

  say ""
  say "Hint: available models depend on providers configured on the runner server."
  say "Check them on the VPS with: sudo -iu github-runner opencode models"
  say ""

  local build_model build_variant review_model review_variant max_cycles current
  current="$(current_var "$repo" GITKEEPR_BUILD_MODEL || true)"
  build_model="$(prompt_value "Build model" "${current:-openai/gpt-5.6-luna}")"
  current="$(current_var "$repo" GITKEEPR_BUILD_VARIANT || true)"
  build_variant="$(prompt_value "Build variant" "${current:-high}")"
  current="$(current_var "$repo" GITKEEPR_REVIEW_MODEL || true)"
  review_model="$(prompt_value "Review model" "${current:-openai/gpt-5.6-sol}")"
  current="$(current_var "$repo" GITKEEPR_REVIEW_VARIANT || true)"
  review_variant="$(prompt_value "Review variant" "${current:-high}")"
  current="$(current_var "$repo" GITKEEPR_MAX_CYCLES || true)"
  max_cycles="$(prompt_value "Max cycles" "${current:-15}")"
  [[ "$max_cycles" =~ ^[1-9][0-9]*$ ]] || die "Max cycles must be a positive integer."

  gh variable set GITKEEPR_BUILD_MODEL -R "$repo" --body "$build_model"
  gh variable set GITKEEPR_BUILD_VARIANT -R "$repo" --body "$build_variant"
  gh variable set GITKEEPR_REVIEW_MODEL -R "$repo" --body "$review_model"
  gh variable set GITKEEPR_REVIEW_VARIANT -R "$repo" --body "$review_variant"
  gh variable set GITKEEPR_MAX_CYCLES -R "$repo" --body "$max_cycles"

  if [[ "$self_repo" -eq 1 ]]; then
    say "Public self-development uses .github/workflows/self-gate.yml and .github/workflows/pr-loop.yml; no standard caller file is created."
  else
    local tmp replace
    tmp="$(mktemp)"
    trap 'rm -f "$tmp"' RETURN
    curl -fsSL "$RAW_BASE/templates/gitkeepr.yml" -o "$tmp"
    mkdir -p "$(dirname "$WORKFLOW_PATH")"

    if [[ -f "$WORKFLOW_PATH" ]] && ! cmp -s "$tmp" "$WORKFLOW_PATH"; then
      say ""
      say "Existing $WORKFLOW_PATH differs from the current GitKeepr template:"
      diff -u "$WORKFLOW_PATH" "$tmp" || true
      read -r -p "Replace it? [y/N]: " replace
      if [[ "$replace" =~ ^[Yy]$ ]]; then
        cp "$tmp" "$WORKFLOW_PATH"
        say "Replaced $WORKFLOW_PATH"
      else
        say "Kept existing $WORKFLOW_PATH"
      fi
    elif [[ ! -f "$WORKFLOW_PATH" ]]; then
      cp "$tmp" "$WORKFLOW_PATH"
      say "Created $WORKFLOW_PATH"
    else
      say "$WORKFLOW_PATH is already current."
    fi
    rm -f "$tmp"
    trap - RETURN
  fi

  say ""
  say "Repository-side setup complete. GitKeepr did not stage or commit anything."
  say "Current working-tree status:"
  git status --short || true
  say ""
  say "On the runner server, run:"
  say "  gitkeepr runner add $repo"
}

project_doctor() {
  require_cmd git
  require_cmd gh
  local failed=0 repo="" visibility="" name value tmp="" runner_lines="" self_repo=0

  if ! git rev-parse --show-toplevel >/dev/null 2>&1; then
    say "FAIL  Git repository not detected"
    return 1
  fi
  say "OK    Git repository detected"

  if gh auth status >/dev/null 2>&1; then
    say "OK    gh authenticated"
  else
    say "FAIL  gh not authenticated"
    failed=1
  fi

  repo="$(repo_name 2>/dev/null || true)"
  if [[ -n "$repo" ]]; then
    say "OK    GitHub repository: $repo"
  else
    say "FAIL  GitHub repository unresolved"
    failed=1
  fi

  if [[ -n "$repo" ]]; then
    visibility="$(repo_visibility 2>/dev/null || true)"
    if [[ -z "$visibility" ]]; then
      say "FAIL  Repository visibility could not be determined"
      failed=1
    elif [[ "${visibility,,}" == "public" ]]; then
      if is_public_self_repo "$repo"; then
        self_repo=1
        say "OK    Public upstream repository uses the GitKeepr self-development gate"
      else
        say "FAIL  Public repository is outside the standard V1 persistent-runner setup"
        failed=1
      fi
    else
      say "OK    Repository visibility is ${visibility,,}"
    fi

    for name in GITKEEPR_BUILD_MODEL GITKEEPR_BUILD_VARIANT GITKEEPR_REVIEW_MODEL GITKEEPR_REVIEW_VARIANT GITKEEPR_MAX_CYCLES; do
      value="$(current_var "$repo" "$name")"
      if [[ -n "$value" ]]; then
        say "OK    Repository variable $name is configured"
      else
        say "FAIL  Repository variable $name is missing or empty; run 'gitkeepr init'"
        failed=1
      fi
    done

    value="$(current_var "$repo" GITKEEPR_MAX_CYCLES)"
    if [[ -n "$value" && ! "$value" =~ ^[1-9][0-9]*$ ]]; then
      say "FAIL  GITKEEPR_MAX_CYCLES must be a positive integer"
      failed=1
    fi

    value="$(current_var "$repo" GITKEEPR_APP_CLIENT_ID)"
    if [[ -n "$value" ]]; then
      say "OK    Repository variable GITKEEPR_APP_CLIENT_ID is configured"
    else
      say "FAIL  Repository variable GITKEEPR_APP_CLIENT_ID is missing; run 'gitkeepr runner add $repo' on the server"
      failed=1
    fi

    if gh secret list -R "$repo" --json name -q '.[].name' 2>/dev/null | grep -Fxq GITKEEPR_APP_PRIVATE_KEY; then
      say "OK    Repository secret GITKEEPR_APP_PRIVATE_KEY exists"
    else
      say "FAIL  Repository secret GITKEEPR_APP_PRIVATE_KEY is missing; run 'gitkeepr runner add $repo' on the server"
      failed=1
    fi

    runner_lines="$(gh api "repos/$repo/actions/runners?per_page=100" --jq '.runners[] | select(.labels[].name == "gitkeepr") | [.name, .status] | @tsv' 2>/dev/null || true)"
    if printf '%s\n' "$runner_lines" | awk -F '\t' '$2 == "online" { found=1 } END { exit !found }'; then
      say "OK    A GitKeepr runner is registered and online"
    elif [[ -n "$runner_lines" ]]; then
      say "FAIL  GitKeepr runner is registered but not online"
      failed=1
    else
      say "FAIL  No repository runner with the gitkeepr label is registered"
      failed=1
    fi

    say "INFO  GitHub App installation access is verified server-side by 'gitkeepr runner add'; project doctor does not have the private key."
  fi

  if [[ "$self_repo" -eq 1 ]]; then
    for name in self-gate.yml pr-loop.yml; do
      if gh api "repos/$repo/contents/.github/workflows/$name" >/dev/null 2>&1; then
        say "OK    .github/workflows/$name is visible on the default branch"
      else
        say "FAIL  .github/workflows/$name is missing from the default branch"
        failed=1
      fi
    done
  elif [[ -f "$WORKFLOW_PATH" ]]; then
    if ! command -v curl >/dev/null 2>&1; then
      say "FAIL  curl is required to check whether $WORKFLOW_PATH is current"
      failed=1
    else
      tmp="$(mktemp)"
      if curl -fsSL "$RAW_BASE/templates/gitkeepr.yml" -o "$tmp"; then
        if cmp -s "$tmp" "$WORKFLOW_PATH"; then
          say "OK    $WORKFLOW_PATH matches the current GitKeepr template"
        else
          say "FAIL  $WORKFLOW_PATH differs from the current GitKeepr template; run 'gitkeepr init' to review replacement"
          failed=1
        fi
      else
        say "FAIL  Could not fetch the current GitKeepr caller template"
        failed=1
      fi
      rm -f "$tmp"
    fi
  else
    say "FAIL  $WORKFLOW_PATH missing; run 'gitkeepr init'"
    failed=1
  fi

  if [[ "$failed" -eq 0 ]]; then
    say "PASS  Repository-side GitKeepr setup looks healthy."
  else
    say "FAIL  Repository has one or more setup problems; diagnostics made no persistent changes."
  fi
  return "$failed"
}

runner_node_runtime_ok() {
  id "$RUNNER_USER" >/dev/null 2>&1 || return 1
  as_runner env PATH="/usr/local/bin:/usr/bin:/bin" bash -c '
    command -v node >/dev/null 2>&1 || exit 1
    command -v npm >/dev/null 2>&1 || exit 1
    command -v npx >/dev/null 2>&1 || exit 1
    version="$(node -p "process.versions.node" 2>/dev/null || true)"
    IFS="." read -r major minor _ <<< "$version"
    [[ "$major" =~ ^[0-9]+$ && "$minor" =~ ^[0-9]+$ ]] || exit 1
    (( major >= 23 )) && exit 0
    (( major == 22 && minor >= 12 )) && exit 0
    (( major == 20 && minor >= 19 )) && exit 0
    exit 1
  '
}

install_node_runtime() {
  local node_arch="" release_json="" node_version="" tarball="" tmpdir=""
  local expected_sha="" actual_sha="" install_dir="" tool=""

  if runner_node_runtime_ok; then
    say "Node.js runtime is compatible for $RUNNER_USER: $(as_runner env PATH="/usr/local/bin:/usr/bin:/bin" node --version)"
    return 0
  fi

  case "$(uname -m)" in
    x86_64|amd64) node_arch="x64" ;;
    aarch64|arm64) node_arch="arm64" ;;
    *) die "Unsupported architecture for Node.js: $(uname -m)." ;;
  esac

  say "Installing a current Node.js LTS runtime for MCP tooling..."
  release_json="$(curl -fsSL https://nodejs.org/dist/index.json)"
  node_version="$(printf '%s' "$release_json" | jq -r '[.[] | select(.lts != false and .lts != null)][0].version // empty')"
  [[ -n "$node_version" ]] || die "Could not resolve the current Node.js LTS release."

  tarball="node-${node_version}-linux-${node_arch}.tar.xz"
  tmpdir="$(mktemp -d)"
  curl -fsSL "https://nodejs.org/dist/${node_version}/${tarball}" -o "$tmpdir/$tarball"
  curl -fsSL "https://nodejs.org/dist/${node_version}/SHASUMS256.txt" -o "$tmpdir/SHASUMS256.txt"

  expected_sha="$(awk -v file="$tarball" '$2 == file { print $1 }' "$tmpdir/SHASUMS256.txt")"
  [[ -n "$expected_sha" ]] || {
    rm -rf "$tmpdir"
    die "Could not resolve checksum for $tarball."
  }
  actual_sha="$(sha256sum "$tmpdir/$tarball" | awk '{print $1}')"
  [[ "$actual_sha" == "$expected_sha" ]] || {
    rm -rf "$tmpdir"
    die "Checksum verification failed for $tarball."
  }

  install_dir="/opt/gitkeepr/node-${node_version}"
  if ! as_root test -x "$install_dir/bin/node"; then
    as_root install -d -o root -g root -m 0755 "$install_dir"
    as_root tar -xJf "$tmpdir/$tarball" -C "$install_dir" --strip-components=1
  fi

  for tool in node npm npx; do
    as_root ln -sfn "$install_dir/bin/$tool" "/usr/local/bin/$tool"
  done
  rm -rf "$tmpdir"

  runner_node_runtime_ok || die "Node.js installation completed but the runtime is not compatible with GitKeepr MCP tooling."
  say "Installed Node.js runtime for $RUNNER_USER: $(as_runner env PATH="/usr/local/bin:/usr/bin:/bin" node --version)"
}

runner_chrome_path() {
  local home="" path=""
  home="$(runner_home)"
  [[ -n "$home" ]] || return 1
  for path in /usr/bin/google-chrome /usr/bin/google-chrome-stable; do
    if [[ -x "$path" ]]; then
      printf '%s\n' "$path"
      return 0
    fi
  done
  find "$home/.cache/gitkeepr/chrome-for-testing" \
    -type f \
    -path '*/chrome-linux*/chrome' \
    -perm -u+x \
    2>/dev/null |
    sort -V |
    tail -n1
}

chrome_for_testing_platform() {
  case "$(uname -m)" in
    x86_64|amd64) printf '%s' "linux64" ;;
    aarch64|arm64) printf '%s' "linux-arm64" ;;
    *) return 1 ;;
  esac
}

install_runner_chrome() {
  local home="" browser_cache="" platform="" release_json="" version="" url="" tmpdir=""

  home="$(runner_home)"
  [[ -n "$home" ]] || die "Could not resolve home directory for $RUNNER_USER."
  browser_cache="$home/.cache/gitkeepr/chrome-for-testing"
  platform="$(chrome_for_testing_platform)" || die "Unsupported architecture for Chrome for Testing: $(uname -m)."
  release_json="$(curl -fsSL https://googlechromelabs.github.io/chrome-for-testing/last-known-good-versions-with-downloads.json)"
  version="$(printf '%s' "$release_json" | jq -r '.channels.Stable.version // empty')"
  url="$(printf '%s' "$release_json" | jq -r --arg platform "$platform" '.channels.Stable.downloads.chrome[] | select(.platform == $platform) | .url // empty')"
  [[ -n "$version" && -n "$url" ]] || die "Could not resolve a stable Chrome for Testing download for $platform."

  say "Installing Chrome for Testing $version for $RUNNER_USER..."
  tmpdir="$(mktemp -d)"
  curl -fsSL "$url" -o "$tmpdir/chrome.zip"
  as_root install -d -o "$RUNNER_USER" -g "$RUNNER_USER" -m 0755 "$browser_cache"
  as_root unzip -q -o "$tmpdir/chrome.zip" -d "$browser_cache"
  as_root chown -R "$RUNNER_USER:$RUNNER_USER" "$browser_cache"
  rm -rf "$tmpdir"
}

runner_opencode_config_path() {
  local home="$1"
  if [[ -f "$home/.config/opencode/opencode.jsonc" ]]; then
    printf '%s/.config/opencode/opencode.jsonc' "$home"
  else
    printf '%s/.config/opencode/opencode.json' "$home"
  fi
}

jsonc_to_json() {
  python3 - "$1" <<'PY'
import json
import sys
from pathlib import Path


def remove_comments(text):
    output = []
    in_string = False
    escaped = False
    index = 0
    while index < len(text):
        char = text[index]
        if in_string:
            output.append(char)
            if escaped:
                escaped = False
            elif char == "\\":
                escaped = True
            elif char == '"':
                in_string = False
            index += 1
            continue
        if char == '"':
            in_string = True
            output.append(char)
            index += 1
        elif char == "/" and index + 1 < len(text) and text[index + 1] == "/":
            index += 2
            while index < len(text) and text[index] not in "\r\n":
                index += 1
        elif char == "/" and index + 1 < len(text) and text[index + 1] == "*":
            end = text.find("*/", index + 2)
            if end == -1:
                raise ValueError("unterminated block comment")
            index = end + 2
        else:
            output.append(char)
            index += 1
    return "".join(output)


def remove_trailing_commas(text):
    output = []
    in_string = False
    escaped = False
    index = 0
    while index < len(text):
        char = text[index]
        if in_string:
            output.append(char)
            if escaped:
                escaped = False
            elif char == "\\":
                escaped = True
            elif char == '"':
                in_string = False
            index += 1
            continue
        if char == '"':
            in_string = True
            output.append(char)
            index += 1
            continue
        if char == ",":
            next_index = index + 1
            while next_index < len(text) and text[next_index].isspace():
                next_index += 1
            if next_index < len(text) and text[next_index] in "]}":
                index += 1
                continue
        output.append(char)
        index += 1
    return "".join(output)


try:
    source = Path(sys.argv[1]).read_text(encoding="utf-8-sig")
    parsed = json.loads(remove_trailing_commas(remove_comments(source)))
except (OSError, ValueError, json.JSONDecodeError) as error:
    print(f"Could not parse JSONC: {error}", file=sys.stderr)
    raise SystemExit(1)

json.dump(parsed, sys.stdout, separators=(",", ":"))
sys.stdout.write("\n")
PY
}

configure_runner_mcp_tools() {
  local opencode_path="$1" home="" npm_prefix="" chrome=""
  local config="" tmp="" normalized=""

  home="$(runner_home)"
  [[ -n "$home" ]] || die "Could not resolve home directory for $RUNNER_USER."
  npm_prefix="$home/.local"
  config="$(runner_opencode_config_path "$home")"

  say "Installing/updating GitKeepr MCP servers for $RUNNER_USER..."
  as_runner npm install --global --prefix "$npm_prefix" \
    chrome-devtools-mcp@latest \
    @upstash/context7-mcp@latest

  chrome="$(runner_chrome_path || true)"
  if [[ -z "$chrome" ]]; then
    install_runner_chrome
    chrome="$(runner_chrome_path || true)"
  else
    say "Runner Chrome already exists: $chrome"
  fi
  [[ -n "$chrome" && -x "$chrome" ]] || die "Chrome installation completed but no executable could be found for $RUNNER_USER."

  tmp="$(mktemp)"
  if as_runner test -f "$config"; then
    as_runner cat "$config" > "$tmp"
  else
    printf '%s\n' '{"$schema":"https://opencode.ai/config.json"}' > "$tmp"
  fi

  normalized="$tmp.normalized"
  if ! jsonc_to_json "$tmp" > "$normalized"; then
    rm -f "$tmp" "$normalized"
    die "Could not parse the OpenCode JSONC configuration."
  fi

  if ! jq \
    --arg chrome "$chrome" \
    --arg chrome_mcp "$npm_prefix/bin/chrome-devtools-mcp" \
    --arg context7 "$npm_prefix/bin/context7-mcp" \
    '
      .mcp = (.mcp // {}) |
      .mcp["chrome-devtools"] = {
        "type": "local",
        "command": [
          $chrome_mcp,
          "--headless",
          "--isolated",
          ("--executablePath=" + $chrome),
          "--experimental-vision",
          "--usage-statistics=false",
          "--chrome-arg=--lang=cs-CZ",
          "--chrome-arg=--accept-lang=cs-CZ,cs,en-US,en"
        ]
      } |
      .mcp.context7 = {
        "type": "local",
        "command": [$context7]
      }
    ' "$normalized" > "$tmp.next"; then
    rm -f "$tmp" "$normalized" "$tmp.next"
    die "Could not update the OpenCode MCP configuration."
  fi

  as_root install -d -o "$RUNNER_USER" -g "$RUNNER_USER" -m 0755 "$(dirname "$config")"
  as_root install -o "$RUNNER_USER" -g "$RUNNER_USER" -m 0644 "$tmp.next" "$config"
  rm -f "$tmp" "$normalized" "$tmp.next"

  say "Configured Chrome DevTools and Context7 MCP servers for $RUNNER_USER."
  as_runner "$opencode_path" mcp list || die "OpenCode could not connect to the configured MCP servers."
}

server_doctor() {
  local failed=0 os_id="" os_like="" arch config_client="" config_key="" config_contents="" mode="" owner=""
  local opencode_path="" cache_path="" home="" service_count="" free_kb="" chrome="" mcp_status=""

  if [[ -r /etc/os-release ]]; then
    # shellcheck disable=SC1091
    . /etc/os-release
    os_id="${ID:-}"
    os_like="${ID_LIKE:-}"
  fi
  if [[ "$os_id" == "ubuntu" || "$os_id" == "debian" || " $os_like " == *" debian "* ]]; then
    say "OK    Supported Debian-family OS${PRETTY_NAME:+: $PRETTY_NAME}"
  else
    say "FAIL  Unsupported OS; GitKeepr V1 server commands support Ubuntu/Debian"
    failed=1
  fi

  if [[ -d /run/systemd/system ]] && command -v systemctl >/dev/null 2>&1; then
    say "OK    systemd detected"
  else
    say "FAIL  systemd is required"
    failed=1
  fi

  arch="$(uname -m 2>/dev/null || true)"
  case "$arch" in
    x86_64|amd64|aarch64|arm64) say "OK    Supported architecture: $arch" ;;
    *) say "FAIL  Unsupported architecture: ${arch:-unknown} (expected amd64 or arm64)"; failed=1 ;;
  esac

  local cmd
  for cmd in curl git jq tar unzip gh python3 openssl xz; do
    if command -v "$cmd" >/dev/null 2>&1; then
      say "OK    $cmd available"
    else
      say "FAIL  $cmd missing; run 'gitkeepr server init'"
      failed=1
    fi
  done

  if runner_node_runtime_ok; then
    say "OK    Node.js runtime is compatible for $RUNNER_USER: $(as_runner env PATH="/usr/local/bin:/usr/bin:/bin" node --version)"
  else
    say "FAIL  Node.js runtime is missing or too old for Chrome DevTools MCP for $RUNNER_USER; run 'gitkeepr server init'"
    failed=1
  fi

  if gh auth status >/dev/null 2>&1; then
    say "OK    admin gh authenticated"
  else
    say "FAIL  admin gh is not authenticated; run 'gh auth login'"
    failed=1
  fi

  if id "$RUNNER_USER" >/dev/null 2>&1; then
    say "OK    $RUNNER_USER user exists"
    opencode_path="$(runner_opencode_path 2>/dev/null || true)"
    if [[ -n "$opencode_path" ]]; then
      say "OK    OpenCode available to $RUNNER_USER: $opencode_path"
      if as_runner "$opencode_path" models >/dev/null 2>&1; then
        say "OK    OpenCode model listing works"
      else
        say "FAIL  'opencode models' failed for $RUNNER_USER"
        failed=1
      fi

      home="$(runner_home)"
      if as_runner test -x "$home/.local/bin/chrome-devtools-mcp"; then
        say "OK    Chrome DevTools MCP installed for $RUNNER_USER"
      else
        say "FAIL  Chrome DevTools MCP missing for $RUNNER_USER; run 'gitkeepr server init'"
        failed=1
      fi
      if as_runner test -x "$home/.local/bin/context7-mcp"; then
        say "OK    Context7 MCP installed for $RUNNER_USER"
      else
        say "FAIL  Context7 MCP missing for $RUNNER_USER; run 'gitkeepr server init'"
        failed=1
      fi

      chrome="$(runner_chrome_path || true)"
      if [[ -n "$chrome" && -x "$chrome" ]]; then
        say "OK    Chrome for Testing available to $RUNNER_USER: $chrome"
      else
        say "FAIL  Chrome for Testing missing for $RUNNER_USER; run 'gitkeepr server init'"
        failed=1
      fi

      mcp_status="$(as_runner "$opencode_path" mcp list 2>&1 || true)"
      if printf '%s\n' "$mcp_status" | grep -Eq 'chrome-devtools.*connected'; then
        say "OK    Chrome DevTools MCP connects through OpenCode"
      else
        say "FAIL  Chrome DevTools MCP is not connected in OpenCode"
        failed=1
      fi
      if printf '%s\n' "$mcp_status" | grep -Eq 'context7.*connected'; then
        say "OK    Context7 MCP connects through OpenCode"
      else
        say "FAIL  Context7 MCP is not connected in OpenCode"
        failed=1
      fi
    else
      say "FAIL  OpenCode is not available to $RUNNER_USER"
      failed=1
    fi
  else
    say "FAIL  $RUNNER_USER user missing"
    failed=1
  fi

  if [[ "$(id -u)" -eq 0 ]]; then
    config_contents="$(cat "$SERVER_CONFIG" 2>/dev/null || true)"
    mode="$(stat -c '%a' "$SERVER_CONFIG" 2>/dev/null || true)"
    owner="$(stat -c '%U:%G' "$SERVER_CONFIG" 2>/dev/null || true)"
  else
    config_contents="$(sudo cat "$SERVER_CONFIG" 2>/dev/null || true)"
    mode="$(sudo stat -c '%a' "$SERVER_CONFIG" 2>/dev/null || true)"
    owner="$(sudo stat -c '%U:%G' "$SERVER_CONFIG" 2>/dev/null || true)"
  fi

  if [[ -n "$config_contents" ]]; then
    while IFS='=' read -r key value; do
      case "$key" in
        GITKEEPR_APP_CLIENT_ID) config_client="$value" ;;
        GITKEEPR_APP_PRIVATE_KEY_PATH) config_key="$value" ;;
      esac
    done <<< "$config_contents"

    if [[ -n "$config_client" ]]; then
      say "OK    App Client ID configured"
    else
      say "FAIL  GITKEEPR_APP_CLIENT_ID missing in $SERVER_CONFIG"
      failed=1
    fi

    if [[ -n "$config_key" ]]; then
      if [[ "$(id -u)" -eq 0 ]] && [[ -r "$config_key" ]]; then
        say "OK    App private key path is readable"
      elif [[ "$(id -u)" -ne 0 ]] && sudo test -r "$config_key"; then
        say "OK    App private key path is readable"
      else
        say "FAIL  App private key path missing or unreadable"
        failed=1
      fi
    else
      say "FAIL  App private key path missing or unreadable"
      failed=1
    fi

    if [[ "$owner" == "root:root" ]]; then
      say "OK    $SERVER_CONFIG is root-owned"
    else
      say "FAIL  $SERVER_CONFIG owner is ${owner:-unknown}; expected root:root"
      failed=1
    fi

    if [[ "$mode" == "600" || "$mode" == "400" ]]; then
      say "OK    $SERVER_CONFIG permissions are restrictive ($mode)"
    else
      say "FAIL  $SERVER_CONFIG permissions are ${mode:-unknown}; expected 600 or 400"
      failed=1
    fi
  else
    say "FAIL  $SERVER_CONFIG is missing, unreadable, or empty"
    failed=1
  fi

  if id "$RUNNER_USER" >/dev/null 2>&1; then
    home="$(runner_home)"
    cache_path="$(runner_cache_path 2>/dev/null || true)"
    if [[ -n "$cache_path" && -r "$cache_path" ]]; then
      say "OK    Actions runner package cache exists: $cache_path"
    else
      say "FAIL  Actions runner package cache missing; run 'gitkeepr server init'"
      failed=1
    fi

    free_kb="$(df -Pk "$home" 2>/dev/null | awk 'NR==2 {print $4}')"
    if [[ -n "$free_kb" ]]; then
      say "OK    Runner filesystem free space: $((free_kb / 1024)) MiB"
    else
      say "WARN  Could not determine runner filesystem free space"
    fi

    if [[ -d "$home/runners" ]]; then
      service_count="$(find "$home/runners" -mindepth 1 -maxdepth 1 -type d | wc -l | tr -d ' ')"
      say "OK    Repository runner directories: $service_count"
    else
      say "OK    No repository runner directories configured yet"
    fi
  fi

  if command -v systemctl >/dev/null 2>&1; then
    service_count="$(systemctl list-units --type=service 'actions.runner.*' --no-legend 2>/dev/null | wc -l | tr -d ' ')"
    say "OK    Loaded Actions runner services: $service_count"
  fi

  if [[ "$failed" -eq 0 ]]; then
    say "PASS  Server prerequisites look healthy."
  else
    say "FAIL  Server has one or more prerequisite problems; diagnostics made no changes."
  fi
  return "$failed"
}

server_init() {
  require_admin

  local os_id="" os_like="" arch="" home="" opencode_path="" existing_config=""
  local existing_client="" existing_key="" client_id="" key_path="" tmp=""
  local cache_path="" release_json="" asset_url="" runner_arch_value=""

  if [[ -r /etc/os-release ]]; then
    # shellcheck disable=SC1091
    . /etc/os-release
    os_id="${ID:-}"
    os_like="${ID_LIKE:-}"
  fi
  [[ "$os_id" == "ubuntu" || "$os_id" == "debian" || " $os_like " == *" debian "* ]] ||
    die "GitKeepr V1 server init supports Ubuntu/Debian only."
  [[ -d /run/systemd/system ]] || die "systemd is required."

  arch="$(uname -m)"
  case "$arch" in
    x86_64|amd64|aarch64|arm64) ;;
    *) die "Unsupported architecture: $arch. GitKeepr V1 supports amd64/x64 and arm64." ;;
  esac

  say "Installing/confirming server prerequisites..."
  as_root apt-get update
  as_root apt-get install -y curl git jq tar unzip xz-utils ca-certificates gh python3 openssl \
    fonts-liberation libasound2 libatk-bridge2.0-0 libatk1.0-0 libcairo2 libcups2 \
    libdbus-1-3 libdrm2 libgbm1 libglib2.0-0 libgtk-3-0 libnspr4 libnss3 \
    libpango-1.0-0 libx11-6 libx11-xcb1 libxcb1 libxcomposite1 libxdamage1 \
    libxext6 libxfixes3 libxkbcommon0 libxrandr2 libxshmfence1 xdg-utils

  if ! id "$RUNNER_USER" >/dev/null 2>&1; then
    say "Creating dedicated $RUNNER_USER user..."
    as_root useradd --create-home --shell /bin/bash "$RUNNER_USER"
  else
    say "$RUNNER_USER already exists."
  fi
  home="$(runner_home)"
  [[ -n "$home" ]] || die "Could not resolve $RUNNER_USER home directory."

  if gh auth status >/dev/null 2>&1; then
    say "Admin gh authentication is already configured."
  else
    say "GitHub CLI authentication is required for runner lifecycle and repository configuration."
    gh auth login
    gh auth status >/dev/null 2>&1 || die "gh authentication did not complete successfully."
  fi

  opencode_path="$(runner_opencode_path 2>/dev/null || true)"
  if [[ -z "$opencode_path" ]]; then
    say "Installing OpenCode for $RUNNER_USER..."
    as_runner bash -lc 'curl -fsSL https://opencode.ai/install | bash'
    opencode_path="$(runner_opencode_path 2>/dev/null || true)"
    [[ -n "$opencode_path" ]] || die "OpenCode installation finished but the executable could not be found for $RUNNER_USER."
  else
    say "OpenCode already exists for $RUNNER_USER:"
    as_runner "$opencode_path" --version || true
  fi

  install_node_runtime
  configure_runner_mcp_tools "$opencode_path"

  say ""
  say "OpenCode authentication is intentionally interactive and runs every time 'gitkeepr server init' runs."
  as_runner "$opencode_path" auth login
  say ""
  say "Models visible to $RUNNER_USER:"
  as_runner "$opencode_path" models

  as_root install -d -o root -g root -m 0755 "$CACHE_DIR"
  runner_arch_value="$(runner_arch)"
  cache_path="$(runner_cache_path)"
  if [[ -r "$cache_path" ]]; then
    say "Actions runner package cache already exists: $cache_path"
  else
    say "Downloading the current stable GitHub Actions runner package for linux-$runner_arch_value..."
    release_json="$(curl -fsSL https://api.github.com/repos/actions/runner/releases/latest)"
    asset_url="$(printf '%s' "$release_json" | jq -r --arg arch "$runner_arch_value" '
      .assets[]
      | select(.name | test("^actions-runner-linux-" + $arch + "-.*\\.tar\\.gz$"))
      | .browser_download_url
    ' | head -n1)"
    [[ -n "$asset_url" && "$asset_url" != "null" ]] || die "Could not resolve the current stable linux-$runner_arch_value Actions runner package."
    tmp="$(mktemp)"
    curl -fsSL "$asset_url" -o "$tmp"
    as_root install -o root -g root -m 0644 "$tmp" "$cache_path"
    rm -f "$tmp"
    say "Cached Actions runner package at $cache_path"
  fi

  if as_root test -e "$SERVER_CONFIG"; then
    existing_config="$(read_protected_file "$SERVER_CONFIG" 2>/dev/null || true)"
    while IFS='=' read -r key value; do
      case "$key" in
        GITKEEPR_APP_CLIENT_ID) existing_client="$value" ;;
        GITKEEPR_APP_PRIVATE_KEY_PATH) existing_key="$value" ;;
      esac
    done <<< "$existing_config"
  fi

  say ""
  say "Create/install the GitKeepr GitHub App manually with repository permissions:"
  say "  Contents: Read and write"
  say "  Issues: Read and write"
  say "  Pull requests: Read and write"
  say "  Workflows: Read and write"
  say "Install it using 'Only selected repositories'."
  say ""

  client_id="$(prompt_value "GitHub App Client ID" "$existing_client")"
  [[ -n "$client_id" ]] || die "GitHub App Client ID is required."

  key_path="$(prompt_value "GitHub App private key path" "$existing_key")"
  [[ -n "$key_path" ]] || die "GitHub App private key path is required."
  if [[ "$key_path" == "~/"* ]]; then
    key_path="$HOME/${key_path#~/}"
  fi
  as_root test -r "$key_path" || die "Private key is not readable: $key_path"

  tmp="$(mktemp)"
  printf 'GITKEEPR_APP_CLIENT_ID=%s\nGITKEEPR_APP_PRIVATE_KEY_PATH=%s\nGITKEEPR_RUNNER_USER=%s\n'     "$client_id" "$key_path" "$RUNNER_USER" > "$tmp"
  as_root install -d -o root -g root -m 0700 "$(dirname "$SERVER_CONFIG")"
  as_root install -o root -g root -m 0600 "$tmp" "$SERVER_CONFIG"
  rm -f "$tmp"

  say ""
  say "Server initialization complete."
  say "Configuration: $SERVER_CONFIG"
  say "Runner package cache: $cache_path"
  say "Existing repository runners were not modified."
}

runner_add() {
  [[ $# -eq 1 ]] || die "Usage: gitkeepr runner add OWNER/REPO"
  local repo="$1" home="" dir="" name="" record="" runner_id="" status="" busy=""
  local cache_path="" answer="" token="" repo_url="" online=false

  require_admin
  require_cmd gh
  require_cmd curl
  require_cmd jq
  require_cmd tar
  require_cmd openssl
  gh auth status >/dev/null 2>&1 || die "Admin gh is not authenticated. Run 'gh auth login'."
  id "$RUNNER_USER" >/dev/null 2>&1 || die "$RUNNER_USER does not exist. Run 'gitkeepr server init'."

  load_server_config
  validate_target_repo "$repo"
  verify_project_vars "$repo"
  verify_app_access "$repo"
  sync_app_credentials "$repo"
  warn_if_caller_missing "$repo"

  home="$(runner_home)"
  dir="$(runner_dir_for "$repo")"
  name="$(runner_name_for "$repo")"
  cache_path="$(runner_cache_path)"
  [[ -r "$cache_path" ]] || die "Actions runner package cache is missing. Run 'gitkeepr server init'."

  record="$(runner_record "$repo" "$name" || true)"
  if [[ -n "$record" ]]; then
    IFS=$'\t' read -r runner_id status busy <<< "$record"
  fi

  if [[ -d "$dir" && -f "$dir/.runner" && "$status" == "online" ]] && runner_service_healthy "$dir"; then
    say "OK    Runner $name is already configured and online."
    say "OK    App credentials were resynchronized."
    return 0
  fi

  if [[ -d "$dir" || -n "$record" ]]; then
    say "Existing GitKeepr runner state for $repo is unhealthy or incomplete."
    read -r -p "Reconfigure it? [y/N]: " answer
    [[ "$answer" =~ ^[Yy]$ ]] || die "Runner was left unchanged."
    remove_runner_installation "$repo" "$dir" "$runner_id"
  fi

  as_root install -d -o "$RUNNER_USER" -g "$RUNNER_USER" -m 0755 "$home/runners" "$dir"
  as_runner tar -xzf "$cache_path" -C "$dir"

  if [[ -x "$dir/bin/installdependencies.sh" ]]; then
    as_root bash -c 'cd "$1" && ./bin/installdependencies.sh' _ "$dir"
  fi

  token="$(gh api -X POST "repos/$repo/actions/runners/registration-token" --jq .token)"
  [[ -n "$token" ]] || die "GitHub did not return a runner registration token."
  repo_url="https://github.com/$repo"

  as_runner bash -c '
    cd "$1"
    ./config.sh       --unattended       --url "$2"       --token "$3"       --name "$4"       --labels gitkeepr       --work _work
  ' _ "$dir" "$repo_url" "$token" "$name"

  as_root bash -c 'cd "$1" && ./svc.sh install "$2"' _ "$dir" "$RUNNER_USER"
  as_root bash -c 'cd "$1" && ./svc.sh start' _ "$dir"

  for _ in $(seq 1 30); do
    record="$(runner_record "$repo" "$name" || true)"
    if [[ -n "$record" ]]; then
      IFS=$'\t' read -r runner_id status busy <<< "$record"
      if [[ "$status" == "online" ]]; then
        online=true
        break
      fi
    fi
    sleep 2
  done

  [[ "$online" == "true" ]] || die "Runner service was installed, but GitHub did not report $name online within 60 seconds. Run 'gitkeepr server doctor' and inspect the runner service."

  say "PASS  Runner $name is registered, running, and online for $repo."
}

runner_remove() {
  [[ $# -eq 1 ]] || die "Usage: gitkeepr runner remove OWNER/REPO"
  local repo="$1" dir="" name="" record="" runner_id="" status="" busy=""

  require_admin
  require_cmd gh
  gh auth status >/dev/null 2>&1 || die "Admin gh is not authenticated. Run 'gh auth login'."
  id "$RUNNER_USER" >/dev/null 2>&1 || die "$RUNNER_USER does not exist."

  [[ "$repo" =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]] || die "Repository must be in OWNER/REPO form."
  gh repo view "$repo" >/dev/null 2>&1 || die "Repository $repo is not accessible with the admin gh login."

  dir="$(runner_dir_for "$repo")"
  name="$(runner_name_for "$repo")"
  record="$(runner_record "$repo" "$name" || true)"
  if [[ -n "$record" ]]; then
    IFS=$'\t' read -r runner_id status busy <<< "$record"
  fi

  if [[ ! -d "$dir" && -z "$record" ]]; then
    say "Runner $name is not configured for $repo."
    return 0
  fi

  remove_runner_installation "$repo" "$dir" "$runner_id"
  say "PASS  Removed GitKeepr runner $name for $repo."
  say "Repository variables, secrets, and workflow files were left unchanged."
}

case "${1:-}" in
  init)
    shift
    [[ $# -eq 0 ]] || die "Unexpected arguments to init."
    project_init
    ;;
  doctor)
    shift
    [[ $# -eq 0 ]] || die "Unexpected arguments to doctor."
    project_doctor
    ;;
  server)
    shift
    case "${1:-}" in
      init)
        shift
        [[ $# -eq 0 ]] || die "Unexpected arguments to server init."
        server_init
        ;;
      doctor)
        shift
        [[ $# -eq 0 ]] || die "Unexpected arguments to server doctor."
        server_doctor
        ;;
      *)
        usage
        exit 2
        ;;
    esac
    ;;
  runner)
    shift
    case "${1:-}" in
      add)
        shift
        runner_add "$@"
        ;;
      remove)
        shift
        runner_remove "$@"
        ;;
      *)
        usage
        exit 2
        ;;
    esac
    ;;
  version|--version|-v)
    say "$VERSION"
    ;;
  help|--help|-h|"")
    usage
    ;;
  *)
    usage
    exit 2
    ;;
esac
